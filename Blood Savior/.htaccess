# ===============================================
# Comprehensive Security and Configuration (Enhanced)
# ===============================================

# 1. SERVER INFORMATION & DIRECTORY LISTING PREVENTION & REWRITE ENGINE
# ----------------------------------------------------------------
# Prevents Apache from displaying its version and other server details in error pages.
ServerSignature Off
# Prevents users from viewing a list of files in directories when no index file is present.
Options -Indexes

# --- Global Rewrite Engine Activation ---
# Enables the URL rewriting engine for all following mod_rewrite rules.
RewriteEngine On
# ----------------------------------------


# 2. HTTP METHOD BLOCKING (Redirects unauthorized methods)
# ----------------------------------------------------------------
# Blocks TRACE, PUT, and DELETE, and REDIRECTS the user.
<IfModule mod_rewrite.c>
    # RewriteEngine On <--- REMOVED: Now declared globally above
    # Check for blocked methods
    RewriteCond %{REQUEST_METHOD} ^(TRACE|PUT|DELETE) [NC]
    # Force a temporary redirect (R=302) to the main page
    RewriteRule .* https://findblooddonor.free.nf/ [R=302,L]
</IfModule>

# 3. BLOCK ACCESS TO SENSITIVE APPLICATION FILES
# ----------------------------------------------------------------
# Deny access to configuration files, etc. (These errors will be
# caught by ErrorDocument 403 and redirected)
<FilesMatch "(\.env|\.ini|\.yaml|\.yml|\.json|\.log|\.md|\.twig|\.tpl|\.inc|composer\.(json|lock)|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Redirect users trying to access Git/SVN directories to the main page (302 redirect).
RedirectMatch 302 /\.(git|svn)/ https://bloodsavior.free.nf/

# 4. SENSITIVE DIRECTORY PROTECTION (Now redirects)
# ----------------------------------------------------------------
# Redirects users trying to access protected paths to the main page (302 redirect).
RedirectMatch 302 ^/protected_data/.*$ https://bloodsavior.free.nf/
RedirectMatch 302 ^/admin/.*\.(json|log)$ https://bloodsavior.free.nf/

# 9. RESTRICT ACCESS TO CONFIGURATION FILES (config.php)
# ----------------------------------------------------------------
# Deny all external HTTP requests (ErrorDocument 403 will redirect this)
<FilesMatch "^config\.php$">
    <IfModule mod_authz_core>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. ALLOW PHP FILES (Existing Rule)
# ----------------------------------------------------------------
<FilesMatch "\.(php)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# 6. SECURITY HEADERS (Existing Rules)
# ----------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
    Header set X-Frame-Options DENY
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 7. PHP CONFIGURATION (Existing Rule)
# ----------------------------------------------------------------
php_value date.timezone Asia/Dhaka

# 8. CUSTOM ERROR PAGES (Redirects all listed errors to the main page)
# ----------------------------------------------------------------
# All errors (404, 403, 500, etc.) are redirected to the main page.
ErrorDocument 404 https://bloodsavior.free.nf/
ErrorDocument 400 https://bloodsavior.free.nf/
ErrorDocument 401 https://bloodsavior.free.nf/
ErrorDocument 403 https://bloodsavior.free.nf/
ErrorDocument 500 https://bloodsavior.free.nf/
ErrorDocument 503 https://bloodsavior.free.nf/
