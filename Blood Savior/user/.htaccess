# 1. Block access to sensitive files
<FilesMatch "\.(json|ini|log|cfg|yaml|yml|sql|bak|dist|sh|zip)$">
    RewriteEngine On
    RewriteRule ^ - [R=404,L]
</FilesMatch>

# ---

# 2. Main Rewrite Rules
RewriteEngine On

# 2a. 🛑 Specific Redirect for /config.php (NEW RULE)
# This rule must be placed before the generic rewrite rule to take precedence.
RewriteRule ^config\.php$ https://bloodsavior.free.nf/ [R=301,L]

# 2b. Main Rewrite Logic
# EXCLUDE: If the request is for a real file (like /css/style.css), skip all following rules.
RewriteCond %{REQUEST_FILENAME} !-f
# EXCLUDE: If the request is for a real directory (like /images), skip all following rules.
RewriteCond %{REQUEST_FILENAME} !-d

# Now, any remaining request (that isn't a file or folder) can be rewritten to index.php.
RewriteRule ^(.*)$ index.php [L]